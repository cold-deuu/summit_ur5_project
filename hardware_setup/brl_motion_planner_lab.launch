<launch>
  <!-- BRL_lab: the BRL_Framework motion planner (Sogang). Lab changes in its code are marked
       [BRL_lab] and all default off (original BRL behavior): ignore_max_points,
       enable_visual_servoing, cartesian_via_hqp, normalize_pose_goals.
       Requires: ur5e_control_ready.launch (+ External Control running),
                 ur5e_moveit_brl_lab.launch (HQP topic controller),
                 ur5e_moveit_planning_brl_lab.launch (summit planning model).
       Parameters: the HQP joint names of the lab controller, and ignore_max_points
       (lab-only switch added to BRL motion_planner.py, marked [BRL_lab]; default off there).
       Action servers: /brl_robot/prepare_navigation, scan_tomato, pick_tomato, place_tomato.
       Do not run send_rviz_moveit_plan.py at the same time (both publish to HQP). -->
  <arg name="ignore_max_points" default="true"/>
  <!-- Visual servoing in Pick (wrist camera2 + brl_lab_vision.launch). Its 2 cm Cartesian steps
       run through HQP (cartesian_via_hqp), like every other BRL_lab motion. -->
  <arg name="enable_visual_servoing" default="true"/>
  <arg name="ccd_preload" default="$(optenv MOVEIT_CCD_PRELOAD /lib/x86_64-linux-gnu/libccd.so.2)"/>
  <node pkg="motion_planning" type="motion_planner_node.py" name="motion_planner_node" output="screen">
    <env name="LD_PRELOAD" value="$(arg ccd_preload)"/>
    <rosparam param="hqp_joint_names">[shoulder_pan_joint, shoulder_lift_joint, elbow_joint, wrist_1_joint, wrist_2_joint, wrist_3_joint]</rosparam>
    <!-- [BRL_lab] BRL's point-count limits (18-30) assume BRL's MoveIt config; lab plans have
         more points for the same path. HQP accepts any count (retimes with TOPP-RA). -->
    <param name="ignore_max_points" value="$(arg ignore_max_points)"/>
    <param name="enable_visual_servoing" value="$(arg enable_visual_servoing)"/>
    <param name="cartesian_via_hqp" value="true"/>
    <!-- [BRL_lab] BRL's pre-pick quaternion (-0.500, 0.516, -0.481, -0.502) has |q|=0.9998.
         MoveIt 1.1.16 uses it un-normalized, the goal sampler's IK never converges and Pick fails
         with "Unable to sample any valid states for goal tree". Normalizing = same rotation. -->
    <param name="normalize_pose_goals" value="true"/>
  </node>
  <!-- The lab has no BRL basket: remove the basket BRL's setup_scene adds (scene only). -->
  <arg name="remove_basket" default="true"/>
  <node if="$(arg remove_basket)" pkg="summit_ur5_hardware_setup" type="remove_brl_basket.py"
        name="brl_lab_remove_basket" output="screen">
    <env name="LD_PRELOAD" value="$(arg ccd_preload)"/>
  </node>
</launch>
