<launch>
  <!-- BRL_lab planning: the same summit model as brl_hqp_sim.launch (arm on the summit,
       gripper, camera bracket), adapted by brl_lab/make_brl_lab_summit.py to the lab UR5e
       (native arm joint names, frozen gripper/wheel joints, elbow limit, wrong collision
       exclusions removed). Joint states come from ur5e_control_ready.launch.
       Planning only: execution goes through the HQP topic controller.
       /robot_description is replaced by this model (the UR driver does not re-read it;
       HQP uses its own calibration/ur5e_calibrated.urdf). -->
  <arg name="rviz" default="true"/>
  <arg name="elbow_limit_deg" default="160"/>
  <!-- /usr/local/lib/libccd.so.2 (source build) shadows the distro libccd that ROS FCL
       was built against: wrong collision distances and "stack smashing" crashes.
       Preload the distro library in every MoveIt process. Set ccd_preload:="" to disable. -->
  <arg name="ccd_preload" default="$(optenv MOVEIT_CCD_PRELOAD /lib/x86_64-linux-gnu/libccd.so.2)"/>
  <param name="robot_description" command="python3 $(dirname)/brl_lab/make_brl_lab_summit.py urdf --elbow-limit-deg $(arg elbow_limit_deg)"/>
  <param name="robot_description_semantic" command="python3 $(dirname)/brl_lab/make_brl_lab_summit.py srdf"/>
  <rosparam command="load" file="$(find summit_ur5e_moveit_config)/config/kinematics.yaml" ns="robot_description_kinematics"/>
  <rosparam command="load" file="$(dirname)/brl_lab/brl_lab_summit_joint_limits.yaml" ns="robot_description_planning"/>
  <!-- TF for the planning model (summit_xl_base_footprint ... ur5e_* links) from the lab
       joint states, so RViz and the BRL planner scene frame (ur5e_base_link) resolve. -->
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="brl_lab_planning_state_publisher"/>
  <node pkg="moveit_ros_move_group" type="move_group" name="move_group" output="screen">
    <env name="LD_PRELOAD" value="$(arg ccd_preload)"/>
    <!-- Fine collision checking (0.005); output waypoint spacing keeps BRL point limits. -->
    <rosparam command="load" file="$(dirname)/brl_lab_ompl_planning.yaml"/>
    <param name="allow_trajectory_execution" value="false"/>
    <param name="planning_scene_monitor/publish_planning_scene" value="true"/>
    <param name="planning_scene_monitor/publish_geometry_updates" value="true"/>
    <param name="planning_scene_monitor/publish_state_updates" value="true"/>
  </node>
  <!-- F/T calibration services for the panel's "F/T calibration" buttons (no robot commands). -->
  <node pkg="summit_ur5_hardware_setup" type="ft_calibration_server.py" name="brl_lab_ft_calibration" output="screen"/>
  <!-- brl_lab.rviz = RobotModel + MotionPlanning + "BRL Actions" panel. -->
  <arg name="rviz_config" default="$(dirname)/brl_lab.rviz"/>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="moveit_rviz" args="-d $(arg rviz_config)">
    <env name="LD_PRELOAD" value="$(arg ccd_preload)"/>
  </node>
</launch>
