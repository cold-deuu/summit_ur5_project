<launch>
  <!-- BRL_lab: BRL perception stack without changes: knowledge graph (in-memory scene graph)
       + BRL sensor node (YOLO 250219.pt; camera2 -> /brl_robot/yolo_detection/camera2_best_target
       for visual servoing; camera1 world view stays idle until connected).
       Start brl_lab_wrist_camera.launch for the wrist camera. -->
  <arg name="wrist_camera" default="true"/>
  <arg name="robot_name" default="brl_robot"/>
  <arg name="camera2_confidence_threshold" default="0.8"/>

  <!-- Lab base is fixed (no Summit, no AMCL). BRL's RobotTracker blocks until
       /<robot>/amcl_pose exists and registers the robot in the knowledge graph on the first
       message, so publish one constant pose (latched, once). fixed_base:=false when a real
       AMCL runs. The pose is in the map frame; nothing in the lab motion path reads it. -->
  <arg name="fixed_base" default="true"/>
  <arg name="base_x" default="0.0"/>
  <arg name="base_y" default="0.0"/>
  <node if="$(arg fixed_base)" pkg="rostopic" type="rostopic" name="brl_lab_fixed_amcl_pose"
        args="pub -l /$(arg robot_name)/amcl_pose geometry_msgs/PoseWithCovarianceStamped
              '{header: {frame_id: map}, pose: {pose: {position: {x: $(arg base_x), y: $(arg base_y), z: 0.0}, orientation: {w: 1.0}}}}'"/>

  <include if="$(arg wrist_camera)" file="$(dirname)/brl_lab_wrist_camera.launch"/>
  <include file="$(find knowledge_interface)/launch/knowledge_graph.launch"/>
  <node pkg="brl_sensor" type="sensor_node.py" name="brl_sensor_node_$(arg robot_name)" output="screen">
    <param name="robot_name" value="$(arg robot_name)"/>
    <!-- [BRL_lab] wrist-camera (visual servoing) boxes need conf >= this; BRL default 0.5 passed the
         pendant's red e-stop as "ripe 0.60". Real tomato in the lab: ~0.97. -->
    <param name="camera2_confidence_threshold" value="$(arg camera2_confidence_threshold)"/>
    <env name="YOLO_OFFLINE" value="1"/>
  </node>
</launch>
