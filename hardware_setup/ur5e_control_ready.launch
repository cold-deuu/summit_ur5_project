<launch>
  <!-- Replaces observe bringup. Loads a position controller; starts no HQP,
       planner, test trajectory, headless URScript, or mobile controller. -->
  <arg name="robot_ip" default="192.168.1.101"/>
  <arg name="reverse_ip" default="192.168.1.110"/>
  <arg name="kinematics_config" default="$(dirname)/calibration/ur5e_factory.yaml"/>
  <include file="$(find ur_robot_driver)/launch/ur5e_bringup.launch">
    <arg name="robot_ip" value="$(arg robot_ip)"/>
    <arg name="reverse_ip" value="$(arg reverse_ip)"/>
    <arg name="kinematics_config" value="$(arg kinematics_config)"/>
    <arg name="headless_mode" value="false"/>
    <arg name="controllers" value="joint_state_controller speed_scaling_state_controller force_torque_sensor_controller scaled_pos_joint_traj_controller"/>
    <arg name="stopped_controllers" value="pos_joint_traj_controller joint_group_vel_controller"/>
  </include>
</launch>
