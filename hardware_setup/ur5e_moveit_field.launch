<launch>
  <!-- Reuse the BRL driver and scaled JTC; starts no hardware bringup. -->
  <arg name="arm_namespace" default="/brl_robot/ur5e"/>
  <arg name="command_enabled" default="true"/>
  <arg name="admittance_enabled" default="true"/>
  <arg name="admittance_mode" default="hold"/>
  <arg name="tracking_admittance" default="true"/>
  <arg name="gravity_compensation" default="false"/>
  <arg name="gravity_model_file" default=""/>
  <arg name="joint_kp" default="50.0"/>
  <arg name="arm_velocity_limit" default="1.57"/>
  <arg name="acceleration_limits" default="false"/>
  <arg name="command_horizon" default="0.02"/>
  <!-- full_model (default): the field robot's whole /brl_robot/robot_description, exported at launch
       (needs the BRL bringup running). HQP locks every non-arm joint, as in the sim, and its model
       frame = the URDF root (mobile base footprint). full_model:=false = arm-only model_file
       (frame ur5e_base_link). Joint tracking is identical; poses/servo targets change frame. -->
  <arg name="full_model" default="true"/>
  <arg name="full_model_file" default="$(env HOME)/.ros/brl_field/field_full.urdf"/>
  <arg name="model_file" default="$(dirname)/field/ur5e_arm.urdf"/>
  <param if="$(arg full_model)" name="/brl_field/full_model_export"
         command="python3 $(dirname)/prepare_field_ur5e_model.py --full --output $(arg full_model_file)"/>
  <!-- HQP visual servoing: subscribe /rci_action_manager/servo_target (graps_link pose in the model frame). -->
  <arg name="servo" default="true"/>
  <arg name="start_speed_scaling_controller" default="true"/>
  <arg name="record" default="true"/>
  <arg name="log_dir" default="$(env HOME)/catkin_ws/artifacts/moveit_field_logs"/>
  <group if="$(arg start_speed_scaling_controller)" ns="$(arg arm_namespace)">
    <rosparam param="hqp_speed_scaling_state_controller">
      type: scaled_controllers/SpeedScalingStateController
      publish_rate: 100
    </rosparam>
    <node pkg="controller_manager" type="spawner" name="hqp_speed_scaling_spawner"
          args="hqp_speed_scaling_state_controller" output="screen"/>
  </group>
  <node pkg="rci_action_manager" type="ur_wrench_to_wrist.py" name="moveit_wrench_to_wrist" output="screen">
    <param name="source_frame" value="ur5e_tool0_controller"/>
    <param name="target_frame" value="ur5e_wrist_3_link"/>
    <remap from="/wrench" to="$(arg arm_namespace)/wrench"/>
    <remap from="/hqp_shadow/wrench" to="/hqp_moveit/wrench"/>
  </node>
  <include if="$(arg gravity_compensation)" file="$(dirname)/ft_gravity_compensation.launch">
    <arg name="model_file" value="$(arg gravity_model_file)"/>
    <arg name="input_topic" value="/hqp_moveit/wrench"/>
    <arg name="output_topic" value="/hqp_moveit/wrench_compensated"/>
  </include>
  <node pkg="rci_action_manager" type="moveit_optimal_real" name="moveit_optimal_controller" output="screen">
    <rosparam command="load" file="$(find rci_action_manager)/config/moveit_optimal.yaml"/>
    <rosparam command="load" file="$(find rci_action_manager)/config/ur5e_action_admittance.yaml"/>
    <rosparam command="load" file="$(find rci_action_manager)/config/moveit_optimal_ur5e_direct.yaml"/>
    <rosparam command="load" file="$(find rci_action_manager)/config/ur5e_field_action.yaml"/>
    <rosparam command="load" file="$(find rci_action_manager)/config/ur5e_field_moveit.yaml"/>
    <rosparam param="joint_names">[ur5e_shoulder_pan_joint, ur5e_shoulder_lift_joint, ur5e_elbow_joint, ur5e_wrist_1_joint, ur5e_wrist_2_joint, ur5e_wrist_3_joint]</rosparam>
    <param name="urdf" value="$(eval arg('full_model_file') if arg('full_model') else arg('model_file'))"/>
    <param name="servo_enabled" value="$(arg servo)"/>
    <param name="wrist_joint" value="ur5e_wrist_3_joint"/>
    <param name="joint_state_topic" value="$(arg arm_namespace)/joint_states"/>
    <param name="wrench_topic" value="$(eval '/hqp_moveit/wrench_compensated' if arg('gravity_compensation') else '/hqp_moveit/wrench')"/>
    <param name="gravity_compensation/enabled" value="$(arg gravity_compensation)"/>
    <param name="gravity_compensation/model_file" value="$(arg gravity_model_file)"/>
    <param name="wrench_frame" value="ur5e_wrist_3_link"/>
    <rosparam param="admittance/sensor_to_wrist_xyz">[0, 0, 0]</rosparam>
    <!-- empty = the model root frame -->
    <param name="telemetry_frame" value="$(eval '' if arg('full_model') else 'ur5e_base_link')"/>
    <param name="command_interface" value="trajectory"/>
    <param name="command_topic" value="$(arg arm_namespace)/ur5e_scaled_pos_joint_traj_controller/command"/>
    <param name="require_position_controller" value="false"/>
    <param name="require_trajectory_controller" value="true"/>
    <param name="controller_manager_service" value="$(arg arm_namespace)/controller_manager/list_controllers"/>
    <param name="trajectory_controller" value="ur5e_scaled_pos_joint_traj_controller"/>
    <param name="controller_joints_parameter" value="$(arg arm_namespace)/ur5e_scaled_pos_joint_traj_controller/joints"/>
    <param name="command_enabled" value="$(arg command_enabled)"/>
    <param name="admittance_enabled" value="$(arg admittance_enabled)"/>
    <param name="admittance_mode" value="$(arg admittance_mode)"/>
    <param name="tracking_admittance" value="$(arg tracking_admittance)"/>
    <param name="command_horizon" value="$(arg command_horizon)"/>
    <param name="kp" value="$(arg joint_kp)"/>
    <param name="acceleration_limits" value="$(arg acceleration_limits)"/>
    <rosparam param="limits/velocity" subst_value="true">[$(arg arm_velocity_limit), $(arg arm_velocity_limit), $(arg arm_velocity_limit), $(arg arm_velocity_limit), $(arg arm_velocity_limit), $(arg arm_velocity_limit)]</rosparam>
    <param name="max_command_gap" value="$(eval 1.2 * float(arg('arm_velocity_limit')) * 0.06 + 0.015)"/>
    <remap from="/ur_hardware_interface/robot_program_running" to="$(arg arm_namespace)/ur_hardware_interface/robot_program_running"/>
    <remap from="/speed_scaling_factor" to="$(arg arm_namespace)/speed_scaling_factor"/>
  </node>
  <node if="$(arg record)" pkg="rci_action_manager" type="log_action_telemetry.py" name="moveit_telemetry_logger" output="screen">
    <param name="controller_namespace" value="/moveit_optimal_controller"/>
    <param name="output_root" value="$(arg log_dir)"/>
  </node>
</launch>
