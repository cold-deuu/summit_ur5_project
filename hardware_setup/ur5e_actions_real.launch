<launch>
  <!-- Existing UR driver/External Control stays running. Do not run shadow or
       another HQP command node concurrently. No hardware driver is started here. -->
  <arg name="command_enabled" default="true"/>
  <!-- UR5e hardware max is pi rad/s. Lab HQP cap defaults to 1.57 rad/s. -->
  <arg name="arm_velocity_limit" default="1.57"/>
  <arg name="command_horizon" default="0.01"/>
  <arg name="se3_kp" default="100.0"/>
  <arg name="joint_kp" default="100.0"/>
  <arg name="record" default="true"/>
  <arg name="log_dir" default="$(env HOME)/catkin_ws/artifacts/real_action_logs"/>
  <!-- Separate 0.015 rad (~0.86 deg) servo/reference lag allowance from the
       100 Hz velocity-derived step. Position limits and fault latch stay active. -->
  <arg name="tracking_lag_margin" default="0.015"/>
  <!-- Command-to-measured gap includes servo following lag, not just one
       10 ms publication interval. Latest direct-position log showed ~40 ms. -->
  <arg name="following_lag_seconds" default="0.04"/>
  <arg name="max_position_step" default="$(eval 1.2 * float(arg('arm_velocity_limit')) * float(arg('following_lag_seconds')) + float(arg('tracking_lag_margin')))"/>
  <arg name="command_topic" default="/hqp_joint_position_controller/command"/>
  <arg name="command_interface" default="direct_position"/>
  <arg name="require_driver_ready" default="true"/>
  <arg name="require_position_controller" default="true"/>
  <param name="whole_body" value="false"/>
  <node pkg="rci_action_manager" type="ur_wrench_to_wrist.py" name="action_wrench_to_wrist" output="screen">
    <remap from="/hqp_shadow/wrench" to="/hqp_action/wrench"/>
  </node>
  <node pkg="rci_action_manager" type="rci_action_manager_real" name="real_action_controller" output="screen">
    <rosparam command="load" file="$(find rci_action_manager)/config/ur5e_action_admittance.yaml"/>
    <param name="telemetry_frame" value="base_link"/>
    <param name="model_file" value="$(dirname)/calibration/ur5e_calibrated.urdf"/>
    <param name="wrist_joint" value="wrist_3_joint"/>
    <param name="joint_state_topic" value="/joint_states"/>
    <param name="command_topic" value="$(arg command_topic)"/>
    <param name="command_interface" value="$(arg command_interface)"/>
    <param name="require_position_controller" value="$(arg require_position_controller)"/>
    <param name="position_controller" value="hqp_joint_position_controller"/>
    <param name="command_enabled" value="$(arg command_enabled)"/>
    <param name="publish_command_joint_states" value="false"/>
    <param name="enable_moveit_action" value="false"/>
    <param name="require_driver_ready" value="$(arg require_driver_ready)"/>
    <param name="stamped_ft" value="true"/>
    <param name="ft_topic" value="/hqp_action/wrench"/>
    <param name="wrench_frame" value="wrist_3_link"/>
    <param name="ft_bias_samples" value="100"/>
    <param name="state_timeout" value="0.25"/>
    <param name="max_position_step" value="$(arg max_position_step)"/>
    <param name="command_horizon" value="$(arg command_horizon)"/>
    <param name="arm_velocity_limit" value="$(arg arm_velocity_limit)"/>
    <param name="joint_kp" value="$(arg joint_kp)"/>
    <param name="joint_goal_tolerance" value="0.003"/>
    <param name="se3_kp" value="$(arg se3_kp)"/>
    <param name="se3_kd" value="1.0"/>
    <param name="admittance/wrench_sign" value="1.0"/>
    <param name="admittance/sensor_offset_z" value="0.0"/>
    <rosparam param="admittance/sensor_to_wrist_rpy">[0, 0, 0]</rosparam>
  </node>
  <node if="$(arg record)" pkg="rci_action_manager" type="log_action_telemetry.py" name="action_telemetry_logger" output="screen">
    <param name="output_root" value="$(arg log_dir)"/>
  </node>
</launch>
