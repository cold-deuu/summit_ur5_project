<?xml version="1.0"?>
<package format="2">
  <name>rci_action_manager</name>
  <version>0.0.0</version>
  <description>UR5e/mobile manipulator HQP action and topic trajectory controllers.</description>

  <maintainer email="leesai2000@khu.ac.kr">Leesai Park</maintainer>

  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>eigen</build_depend>

  <depend>rci_holistic_controller</depend>
  <depend>sca_pkg</depend>

  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>eiquadprog</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>controller_interface</depend>
  <depend>std_msgs</depend>
  <depend>actionlib</depend>
  <depend>actionlib_msgs</depend>
  <depend>pinocchio</depend>
  <depend>tf_conversions</depend>
  <depend>tf</depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>std_srvs</depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>mujoco_ros</exec_depend>
  <exec_depend>summit_ur5e_moveit_config</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
