<launch>
  <!-- Runs the compiled REAL entry point against MuJoCo, using only /mock_hw/*. -->
  <param name="whole_body" value="false"/>
  <node pkg="rci_action_manager" type="moveit_mujoco_backend.py" name="mujoco_backend" output="screen">
    <env name="MUJOCO_GL" value="disable"/>
    <param name="headless" value="true"/><param name="mock_real" value="true"/>
  </node>
  <node pkg="rci_action_manager" type="moveit_optimal_real" name="moveit_optimal_controller" output="screen">
    <rosparam command="load" file="$(find rci_action_manager)/config/moveit_optimal.yaml"/>
    <param name="command_enabled" value="true"/>
    <param name="joint_state_topic" value="/mock_hw/joint_states"/>
    <param name="command_topic" value="/mock_hw/command"/>
    <param name="wrench_topic" value="/mock_hw/wrench"/>
    <param name="wrench_frame" value="ee_site"/>
  </node>
</launch>
