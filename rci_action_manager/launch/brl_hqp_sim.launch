<launch>
  <!-- BRL motion planner -> HQP (moveit_optimal) in MuJoCo.
       The BRL MoveIt config is not available in sim, so this repo's model runs
       as a planning-only move_group stand-in. Start the BRL node separately:
       rosrun motion_planning motion_planner_node.py brl_robot -->
  <arg name="headless" default="false"/>
  <arg name="model_file" default="$(find summit_ur5e_moveit_config)/config/mobile_mujoco_scene.xml"/>
  <arg name="urdf" default="$(find summit_ur5e_moveit_config)/config/mobile_manipulator.urdf"/>
  <include file="$(find rci_action_manager)/launch/moveit_optimal_sim.launch">
    <arg name="mobile" value="true"/>
    <arg name="headless" value="$(arg headless)"/>
    <arg name="model_file" value="$(arg model_file)"/>
    <arg name="urdf" value="$(arg urdf)"/>
    <arg name="rviz" value="false"/>
    <arg name="planning" value="false"/>
  </include>
  <param name="robot_description" textfile="$(arg urdf)"/>
  <param name="robot_description_semantic" textfile="$(find summit_ur5e_moveit_config)/config/mobile_manipulator.srdf"/>
  <rosparam command="load" file="$(find summit_ur5e_moveit_config)/config/kinematics.yaml" ns="robot_description_kinematics"/>
  <rosparam command="load" file="$(find summit_ur5e_moveit_config)/config/brl_sim_joint_limits.yaml" ns="robot_description_planning"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="moveit_robot_state_publisher"/>
  <node pkg="moveit_ros_move_group" type="move_group" name="move_group" output="screen">
    <rosparam command="load" file="$(find summit_ur5e_moveit_config)/config/brl_sim_ompl_planning.yaml"/>
    <param name="allow_trajectory_execution" value="false"/>
  </node>
</launch>
