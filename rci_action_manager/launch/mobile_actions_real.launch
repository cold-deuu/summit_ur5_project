<launch>
  <!-- real.cpp deliberately retains its commented publish() call. State only. -->
  <arg name="hardware_launch" default=""/>
  <arg name="ft_topic" default="/brl_robot/ft_sensor"/>
  <arg name="base_state_topic" default="/brl_robot/odom"/>
  <arg name="base_command_topic" default="/brl_robot/cmd_vel"/>
  <param name="whole_body" value="true"/>
  <include if="$(eval arg('hardware_launch') != '')" file="$(arg hardware_launch)"/>
  <node pkg="rci_action_manager" type="rci_action_manager_real" name="mobile_action_controller" output="screen">
    <param name="ft_topic" value="$(arg ft_topic)"/>
    <param name="model_file" value="$(find summit_ur5e_moveit_config)/config/mobile_action_control.urdf"/>
    <param name="base_state_topic" value="$(arg base_state_topic)"/>
    <param name="base_command_topic" value="$(arg base_command_topic)"/>
  </node>
</launch>
