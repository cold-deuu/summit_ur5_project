<?xml version="1.0"?>
<package format="2">
  <name>brl_lab_rviz_panel</name>
  <version>0.0.1</version>
  <description>RViz panel to send BRL motion planner actions and watch the HQP controller (BRL_lab).</description>
  <maintainer email="lee081847@khu.ac.kr">chan</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>rviz</depend>
  <depend>pluginlib</depend>
  <depend>actionlib</depend>
  <depend>brl_interfaces</depend>
  <depend>rci_action_manager</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>qtbase5-dev</depend>
  <export>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
