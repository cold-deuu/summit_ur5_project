# PickTomato Action
# 토마토 picking (Visual Servoing 포함)
# BT: PickTomato node에서 호출

# Goal
string robot_name        # 로봇 이름
string tomato_name       # 토마토 이름 (로깅/KB 업데이트용)
geometry_msgs/Point tomato_position  # 토마토 3D 위치 (world frame)

---
# Result
bool success             # 성공 여부
string message           # 결과 메시지
string[] facts           # 03 호환 필드; 01에서는 빈 배열 사용
float32[] confidences    # 03 호환 필드; 01에서는 빈 배열 사용

---
# Feedback
int32 progress           # 진행률 (0-100)
string status            # 현재 상태
