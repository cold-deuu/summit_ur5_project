<?xml version="1.0"?>
<package format="2">
  <name>task_planner</name>
  <version>1.0.0</version>
  <description>
    03 offline plan replay with ROS actionlib and 01 motion/sensing.
  </description>

  <maintainer email="brl@example.com">BRL Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- Build Dependencies -->
  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>common_models</build_depend>
  <build_depend>brl_interfaces</build_depend>

  <!-- Export Dependencies -->
  <build_export_depend>rospy</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend>
  <build_export_depend>common_models</build_export_depend>
  <build_export_depend>brl_interfaces</build_export_depend>

  <!-- Runtime Dependencies -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>common_models</exec_depend>
  <exec_depend>brl_interfaces</exec_depend>

  <exec_depend>python3-yaml</exec_depend>
  <depend>actionlib</depend>
  <depend>std_srvs</depend>
  <export></export>
</package>