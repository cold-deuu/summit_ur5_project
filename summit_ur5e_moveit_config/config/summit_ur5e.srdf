<?xml version="1.0" ?>
<robot name="ur5e">
	<group name="manipulator">
		<chain base_link="ur5e_base_link" tip_link="ur5e_wrist_3_link"/>
	</group>
	<group_state name="home" group="manipulator">
		<joint name="ur5e_shoulder_pan_joint" value="0"/>
		<joint name="ur5e_shoulder_lift_joint" value="-1.57"/>
		<joint name="ur5e_elbow_joint" value="1.57"/>
		<joint name="ur5e_wrist_1_joint" value="-1.57"/>
		<joint name="ur5e_wrist_2_joint" value="-1.57"/>
		<joint name="ur5e_wrist_3_joint" value="0"/>
	</group_state>
	<disable_collisions link1="ur5e_base_link" link2="ur5e_shoulder_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_base_link" link2="ur5e_upper_arm_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_ee_link" link2="ur5e_wrist_2_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_ee_link" link2="ur5e_wrist_3_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_forearm_link" link2="ur5e_shoulder_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_forearm_link" link2="ur5e_upper_arm_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_forearm_link" link2="ur5e_wrist_1_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_forearm_link" link2="ur5e_wrist_2_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_shoulder_link" link2="ur5e_upper_arm_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_upper_arm_link" link2="ur5e_wrist_1_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_wrist_1_link" link2="ur5e_wrist_2_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_wrist_1_link" link2="ur5e_wrist_3_link" reason="Adjacent"/>
	<disable_collisions link1="ur5e_wrist_2_link" link2="ur5e_wrist_3_link" reason="Adjacent"/>
</robot>
