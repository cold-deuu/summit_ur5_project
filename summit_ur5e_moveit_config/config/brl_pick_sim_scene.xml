<?xml version="1.0" ?>
<!-- BRL Pick test scene = mobile_mujoco_scene.xml + one tomato (visual only, no contact).
     MuJoCo world = robot_base_footprint = summit_xl_base_footprint while the base stays at
     the origin (base_mode fixed). Checked: graps_link / hand_camera_link FK match MoveIt.

     Tomato: Pick goal (0.08, -0.36, 1.20) (brl_pick_sim.launch -> panel default) moved +1.5 cm
     in x and -1.0 cm in z, so visual servoing has to correct the error. The goal sits in front
     of the BRL base-pick pose [90,-23,-125,-33,87,-88] deg: the tomato is in the wrist camera
     view there (~0.28 m ahead) and pre-pick is the same IK branch (max joint change ~7 deg).
     The lab tomato (0.771, -0.133, 0.994) needed another IK branch (>= 96 deg) from base-pick. Ripe-tomato size
     (66 mm wide, 58 mm tall) with calyx and stem; the BRL YOLO model (250219.pt) rates
     this render "ripe" 0.93 from the pre-pick view.
     The wrist camera is added by brl_sim_wrist_camera.py (hand_camera_link mount). -->
<mujoco model="summit_brl_pick">
	<option noslip_iterations="70" integrator="implicitfast"/>
	<size njmax="3000" nconmax="1000"/>
	<option timestep="0.001"/>
	<include file="mobile_mujoco_model.xml"/>
	<asset>
		<texture name="floor_tex" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="100" height="100"/>
		<material name="floor_material" texture="floor_tex" texuniform="true"/>
	</asset>
	<visual>
		<map force="0.1"/>
	</visual>
	<default>
		<default class="viz">
			<geom contype="0" conaffinity="0" group="1" type="mesh" rgba=".6 .6 .7 1"/>
		</default>
		<default class="cls">
			<geom group="2" rgba="0.79216 0.81961 0.93333 0.5"/>
		</default>
		<default class="tomato">
			<geom contype="0" conaffinity="0" group="1"/>
		</default>
	</default>
	<worldbody>
		<geom name="ground" type="plane" size="5 5 1" pos="0 0 0" material="floor_material" condim="6"/>
		<light directional="false" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="1 1 3" dir="-1 -1 -3"/>
		<light directional="false" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="1 -1 3" dir="-1 1 -3"/>
		<light directional="false" diffuse=".8 .8 .8" specular="0.3 0.3 0.3" pos="-1 0 3" dir="1 0 -3"/>
		<body name="tomato_0" pos="0.095 -0.36 1.19">
			<geom name="tomato_0_fruit" class="tomato" type="ellipsoid" size="0.033 0.033 0.029" rgba="0.80 0.08 0.05 1"/>
			<geom name="tomato_0_calyx" class="tomato" type="ellipsoid" size="0.016 0.016 0.004" pos="0 0 0.028" rgba="0.15 0.45 0.10 1"/>
			<geom name="tomato_0_stem" class="tomato" type="cylinder" size="0.003 0.04" pos="0 0 0.07" rgba="0.20 0.50 0.15 1"/>
		</body>
	</worldbody>
</mujoco>
