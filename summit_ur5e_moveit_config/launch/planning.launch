<launch>
  <arg name="rviz" default="true"/>
  <arg name="mobile" default="false"/>
  <arg name="model_file" default="$(eval find('summit_ur5e_moveit_config') + ('/config/mobile_manipulator.urdf' if arg('mobile') else '/config/ur5e.urdf'))"/>
  <arg name="semantic_file" default="$(eval find('summit_ur5e_moveit_config') + ('/config/mobile_manipulator.srdf' if arg('mobile') else '/config/summit_ur5e.srdf'))"/>
  <!-- Optional process-local fix for installations shadowing distro libccd. -->
  <arg name="ccd_preload" default="$(optenv MOVEIT_CCD_PRELOAD '')"/>
  <param name="robot_description" textfile="$(arg model_file)"/>
  <param name="robot_description_semantic" textfile="$(arg semantic_file)"/>
  <rosparam command="load" file="$(find summit_ur5e_moveit_config)/config/kinematics.yaml" ns="robot_description_kinematics"/>
  <rosparam command="load" file="$(find summit_ur5e_moveit_config)/config/joint_limits.yaml" ns="robot_description_planning"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="moveit_robot_state_publisher"/>
  <node pkg="moveit_ros_move_group" type="move_group" name="move_group" output="screen">
    <env name="LD_PRELOAD" value="$(arg ccd_preload)"/>
    <rosparam command="load" file="$(find summit_ur5e_moveit_config)/config/ompl_planning.yaml"/>
    <param name="allow_trajectory_execution" value="false"/>
    <param name="planning_scene_monitor/publish_planning_scene" value="true"/>
    <param name="planning_scene_monitor/publish_geometry_updates" value="true"/>
    <param name="planning_scene_monitor/publish_state_updates" value="true"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="moveit_rviz" args="-d $(find summit_ur5e_moveit_config)/config/moveit.rviz"/>
</launch>
